USERNAME=kenny
# PASSWORD must be a bcrypt hash — generate with:
#   php -r "echo password_hash('yourpassword', PASSWORD_BCRYPT);"
PASSWORD=$2y$12$ZnV9qlT1CH.ktO8MkMfKQO8HCFfREUFQSMbeBuHGCJJwMQfiQP9Ae

# Random secret for the /cron endpoint — generate with:
#   php -r "echo bin2hex(random_bytes(32));"
CRON_SECRET=938b8431437d88ace742b76af9f2f21f7857be561d2bafff21a333039c2a8a51

# Random secret for the POST /api/upload endpoint (Authorization: Bearer <secret>).
# Leave empty to disable the endpoint entirely. Generate with:
#   php -r "echo bin2hex(random_bytes(32));"
API_UPLOAD_SECRET=

# Maximum upload size in megabytes (default: 3072 = 3 GiB).
# Must match upload_max_filesize/post_max_size in php.ini and client_max_body_size in nginx.
MAX_UPLOAD_MB=3072
